#!/bin/sh
set -eu

# Never ship reusable SSH host private keys in the immutable image. New host
# keys are generated by cyberhive-onboarding-init into the per-boot overlay.
rm -f /etc/ssh/ssh_host_*

cat >/etc/motd <<'MOTD'
CYBERDJS / CyberHIVE Live Appliance v0.2

Dynamic LAN, SSH, pairing and safety information is shown at interactive login.
Run: cyberhive-welcome
Run: cyberhive-live-health
Run: cyberhive-inventory
Run: cyberhive-host-disk-guard
Run: cyberhive-support-bundle
MOTD

systemctl enable cyberhive-onboarding-init.service
systemctl enable ssh.service
systemctl enable avahi-daemon.service
systemctl enable cyberhive-host-disk-guard.service
systemctl enable cyberhive-live-agent.service
systemctl enable cyberhive-web.service
