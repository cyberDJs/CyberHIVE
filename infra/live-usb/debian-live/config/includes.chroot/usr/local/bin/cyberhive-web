#!/usr/bin/env python3
import hmac
import ipaddress
import json
import os
import secrets
import subprocess
import time
from http import HTTPStatus
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

CONTROL = Path('/run/cyberhive/control')
STATE = Path('/run/cyberhive/state')
EVIDENCE = Path('/run/cyberhive/evidence')
PAIR_FILE = CONTROL / 'pairing-code'
TOKEN_FILE = CONTROL / 'web-session-token'
ROLE_FILE = CONTROL / 'role'
PORT = int(os.environ.get('CYBERHIVE_WEB_PORT', '80'))
ROLES = {'controller-worker', 'worker', 'devbridge-request', 'offline-diagnostics', 'rescue'}
ATTEMPTS = {}
TAILNETS = (ipaddress.ip_network('100.64.0.0/10'), ipaddress.ip_network('fd7a:115c:a1e0::/48'))
TRUSTED_HOST_NAMES = {'localhost', 'cyberhive', 'cyberhive.local'}
TRUSTED_TAILSCALE_NAMES = set()
for name in (os.environ.get('CYBERHIVE_TAILSCALE_HOSTNAME', ''), os.uname().nodename):
    name = name.strip().lower().rstrip('.')
    if name:
        TRUSTED_HOST_NAMES.add(name)
        TRUSTED_HOST_NAMES.add(f'{name}.local')
        TRUSTED_TAILSCALE_NAMES.add(name)

CONTROL.mkdir(parents=True, exist_ok=True)
EVIDENCE.mkdir(parents=True, exist_ok=True)
SESSION_TOKEN = secrets.token_urlsafe(32)
CSRF_TOKEN = secrets.token_urlsafe(32)
TOKEN_FILE.write_text(SESSION_TOKEN + '\n', encoding='utf-8')
os.chmod(TOKEN_FILE, 0o600)

HTML = r'''<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CyberHIVE v0.3</title><style>body{background:#05080d;color:#e7f7fb;font:15px system-ui;max-width:980px;margin:auto;padding:30px}h1{color:#5ff6ff}section{border:1px solid #163945;border-radius:12px;padding:16px;margin:12px 0}button,input,select{background:#0d2028;color:#e7f7fb;border:1px solid #245765;border-radius:7px;padding:9px}pre{white-space:pre-wrap;word-break:break-word}.muted{color:#85a7b1}</style></head><body><h1>CYBERDJS / CyberHIVE v0.3</h1><section><b>Management auth:</b> <span id="auth">checking</span><div class="muted">Tailnet peers are authenticated by the private management network. Physical-console pairing remains a fallback.</div><div id="pair"><input id="code" maxlength="6" placeholder="local pair code"><button onclick="pair()">Pair fallback</button></div></section><section><b>Role intent:</b> <select id="role"><option>controller-worker</option><option>worker</option><option>devbridge-request</option><option>offline-diagnostics</option><option>rescue</option></select> <button onclick="setRole()">Set</button></section><section><button onclick="support()">Build support bundle</button> <a id="download" hidden href="/api/support-download">download</a><span id="support"></span></section><section><pre id="health">loading</pre></section><script>let csrf='';async function req(p,o){let r=await fetch(p,o),t=await r.text(),d;try{d=JSON.parse(t)}catch{d={error:t}}if(!r.ok)throw Error(d.error||r.statusText);return d}async function refresh(){try{let s=await req('/api/session');auth.textContent=s.auth;role.value=s.role||'controller-worker';pair.hidden=s.auth==='tailnet';csrf=s.csrf||'';if(s.paired){let h=await req('/api/health');health.textContent=JSON.stringify(h,null,2)}else{health.textContent='pair locally or connect through Tailscale to view health'}}catch(e){health.textContent=e.message}}async function pair(){try{await req('/api/pair',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:code.value})});code.value='';refresh()}catch(e){auth.textContent=e.message}}async function setRole(){try{await req('/api/role',{method:'POST',headers:{'Content-Type':'application/json','X-CyberHIVE-CSRF':csrf},body:JSON.stringify({role:role.value})});refresh()}catch(e){alert(e.message)}}async function support(){try{let d=await req('/api/support',{method:'POST',headers:{'X-CyberHIVE-CSRF':csrf}});support.textContent=' '+d.bundle;download.hidden=false}catch(e){support.textContent=' '+e.message}}refresh();setInterval(refresh,10000)</script></body></html>'''

def run_json(argv):
    proc = subprocess.run(argv, capture_output=True, text=True, timeout=8, check=False)
    if proc.returncode not in (0, 4):
        return {'status': 'error', 'command': argv[0], 'detail': proc.stderr.strip() or proc.stdout.strip()}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {'status': 'error', 'command': argv[0], 'detail': proc.stdout.strip()}

def cookie_token(headers):
    cookie = SimpleCookie()
    try:
        cookie.load(headers.get('Cookie', ''))
    except Exception:
        return ''
    morsel = cookie.get('cyberhive_session')
    return morsel.value if morsel else ''

def normalize_host(value):
    value = (value or '').strip()
    if not value or any(ch.isspace() for ch in value):
        return ''
    if value.startswith('['):
        end = value.find(']')
        if end < 0:
            return ''
        host = value[1:end]
        rest = value[end + 1:]
        if rest and not (rest.startswith(':') and rest[1:].isdigit()):
            return ''
    else:
        host = value
        if host.count(':') == 1:
            maybe_host, maybe_port = host.rsplit(':', 1)
            if maybe_port.isdigit():
                host = maybe_host
    return host.rstrip('.').lower()

def trusted_management_host(host):
    if not host:
        return False
    try:
        addr = ipaddress.ip_address(host)
    except ValueError:
        if host in TRUSTED_HOST_NAMES:
            return True
        return any(host.startswith(f'{name}.') and host.endswith('.ts.net') for name in TRUSTED_TAILSCALE_NAMES)
    return addr.is_loopback or addr.is_link_local or addr.is_private or any(addr in network for network in TAILNETS)

def origin_host(value):
    if not value:
        return ''
    try:
        parsed = urlsplit(value)
    except ValueError:
        return ''
    if parsed.scheme not in {'http', 'https'} or not parsed.hostname:
        return ''
    return normalize_host(parsed.hostname)

def trusted_management_request(headers):
    host = normalize_host(headers.get('Host', ''))
    if not trusted_management_host(host):
        return False
    origin = headers.get('Origin', '')
    if origin:
        peer = origin_host(origin)
        if not trusted_management_host(peer) or peer != host:
            return False
    return True

class Handler(BaseHTTPRequestHandler):
    server_version = 'CyberHIVE/0.3'

    def security_headers(self, content_type='application/json; charset=utf-8'):
        self.send_header('Content-Type', content_type)
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Content-Security-Policy', "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; object-src 'none'; frame-ancestors 'none'")

    def send_json(self, status, payload, extra_headers=None):
        body = json.dumps(payload, separators=(',', ':')).encode()
        self.send_response(status)
        self.security_headers()
        for key, value in (extra_headers or {}).items():
            self.send_header(key, value)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def is_tailnet_peer(self):
        try:
            addr = ipaddress.ip_address(self.client_address[0])
        except ValueError:
            return False
        return any(addr in network for network in TAILNETS)

    def is_paired(self):
        if self.is_tailnet_peer():
            return True
        supplied = cookie_token(self.headers)
        return bool(supplied) and hmac.compare_digest(supplied, SESSION_TOKEN)

    def require_pairing(self):
        if self.is_paired():
            return True
        self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'tailnet identity or local pairing required'})
        return False

    def require_management_request(self):
        if trusted_management_request(self.headers):
            return True
        self.send_json(HTTPStatus.FORBIDDEN, {'error': 'trusted management Host/Origin required'})
        return False

    def require_mutation_auth(self):
        if not self.require_pairing():
            return False
        if not self.require_management_request():
            return False
        supplied = self.headers.get('X-CyberHIVE-CSRF', '')
        if not supplied or not hmac.compare_digest(supplied, CSRF_TOKEN):
            self.send_json(HTTPStatus.FORBIDDEN, {'error': 'request-bound CSRF credential required'})
            return False
        return True

    def read_json_body(self):
        content_type = self.headers.get('Content-Type', '').split(';', 1)[0].strip().lower()
        if content_type != 'application/json':
            raise ValueError('application/json required')
        length = int(self.headers.get('Content-Length', '0') or '0')
        if length < 0 or length > 4096:
            raise ValueError('request body too large')
        return json.loads(self.rfile.read(length) or b'{}')

    def do_GET(self):
        if self.path.startswith('/api/') and not self.require_management_request(): return
        if self.path == '/':
            body = HTML.encode()
            self.send_response(HTTPStatus.OK)
            self.security_headers('text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers(); self.wfile.write(body); return
        if self.path == '/api/health':
            if not self.require_pairing(): return
            self.send_json(HTTPStatus.OK, run_json(['/usr/local/bin/cyberhive-live-health'])); return
        if self.path == '/api/inventory':
            if not self.require_pairing(): return
            self.send_json(HTTPStatus.OK, run_json(['/usr/local/bin/cyberhive-inventory'])); return
        if self.path == '/api/session':
            if not self.require_management_request(): return
            role = ROLE_FILE.read_text().strip() if ROLE_FILE.exists() else 'role-selector'
            mode_file = STATE / 'ssh-mode'
            mode = mode_file.read_text().strip() if mode_file.exists() else 'initializing'
            auth = 'tailnet' if self.is_tailnet_peer() else ('paired' if self.is_paired() else 'unpaired')
            payload = {'paired': self.is_paired(), 'auth': auth, 'role': role, 'ssh_auth_mode': mode, 'remote_help': 'disabled'}
            if self.is_paired():
                payload['csrf'] = CSRF_TOKEN
            self.send_json(HTTPStatus.OK, payload); return
        if self.path == '/api/support-download':
            if not self.require_pairing(): return
            bundles = sorted(EVIDENCE.glob('support-*.tar.gz'), key=lambda p: p.stat().st_mtime, reverse=True)
            if not bundles:
                self.send_json(HTTPStatus.NOT_FOUND, {'error': 'no support bundle generated'}); return
            target = bundles[0]; body = target.read_bytes()
            self.send_response(HTTPStatus.OK); self.security_headers('application/gzip')
            self.send_header('Content-Disposition', f'attachment; filename="{target.name}"')
            self.send_header('Content-Length', str(len(body))); self.end_headers(); self.wfile.write(body); return
        self.send_json(HTTPStatus.NOT_FOUND, {'error': 'not found'})

    def do_POST(self):
        if self.path.startswith('/api/') and not self.require_management_request(): return
        if self.path == '/api/pair':
            now = time.monotonic(); peer = self.client_address[0]
            recent = [t for t in ATTEMPTS.get(peer, []) if now - t < 60]
            if len(recent) >= 5:
                ATTEMPTS[peer] = recent
                self.send_json(HTTPStatus.TOO_MANY_REQUESTS, {'error': 'pairing rate limit exceeded'}); return
            ATTEMPTS[peer] = recent + [now]
            try:
                supplied = str(self.read_json_body().get('code', '')); expected = PAIR_FILE.read_text().strip()
            except Exception:
                self.send_json(HTTPStatus.BAD_REQUEST, {'error': 'invalid pairing request'}); return
            if not hmac.compare_digest(supplied, expected):
                self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'invalid pairing code'}); return
            ATTEMPTS.pop(peer, None)
            self.send_json(HTTPStatus.OK, {'paired': True}, {'Set-Cookie': f'cyberhive_session={SESSION_TOKEN}; HttpOnly; SameSite=Strict; Path=/'}); return
        if self.path == '/api/role':
            if not self.require_mutation_auth(): return
            try: role = str(self.read_json_body().get('role', ''))
            except Exception:
                self.send_json(HTTPStatus.BAD_REQUEST, {'error': 'invalid role request'}); return
            if role not in ROLES:
                self.send_json(HTTPStatus.BAD_REQUEST, {'error': 'unsupported role'}); return
            ROLE_FILE.write_text(role + '\n', encoding='utf-8')
            self.send_json(HTTPStatus.OK, {'role': role, 'effect': 'boot-session intent only'}); return
        if self.path == '/api/support':
            if not self.require_mutation_auth(): return
            proc = subprocess.run(['/usr/local/bin/cyberhive-support-bundle'], capture_output=True, text=True, timeout=20, check=False)
            if proc.returncode != 0:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {'error': proc.stderr.strip() or 'support bundle failed'}); return
            bundle = Path(proc.stdout.strip().splitlines()[-1]).name
            self.send_json(HTTPStatus.OK, {'bundle': bundle}); return
        self.send_json(HTTPStatus.NOT_FOUND, {'error': 'not found'})

    def log_message(self, fmt, *args):
        print(f'{self.client_address[0]} - {fmt % args}', flush=True)

if __name__ == '__main__':
    ThreadingHTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
