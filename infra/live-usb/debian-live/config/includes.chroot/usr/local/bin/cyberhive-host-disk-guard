#!/bin/sh
set -eu

. /etc/cyberhive/live/config.env
mkdir -p "$CYBERHIVE_EVIDENCE_DIR"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT HUP INT TERM

lsblk -dnpo NAME,TYPE,RM 2>/dev/null | awk '$2 == "disk" && $3 == "0" {print $1}' | while IFS= read -r disk; do
  [ -n "$disk" ] || continue
  lsblk -nrpo NAME,MOUNTPOINT "$disk" 2>/dev/null | while IFS= read -r line; do
    dev=${line%% *}
    mountpoint=${line#* }
    [ "$mountpoint" != "$line" ] || mountpoint=''
    [ -n "$mountpoint" ] || continue
    opts=$(findmnt -nr -o OPTIONS --target "$mountpoint" 2>/dev/null || true)
    case ",$opts," in
      *,rw,*) printf '%s\t%s\t%s\n' "$disk" "$dev" "$mountpoint" >>"$tmp" ;;
    esac
  done
done

if [ -s "$tmp" ]; then
  status='fail'
  violations=$(awk -F '\t' '{printf "%s%s:%s:%s", sep, $1, $2, $3; sep=","}' "$tmp")
  rc=4
else
  status='pass'
  violations=''
  rc=0
fi

jq -n \
  --arg status "$status" \
  --arg violations "$violations" \
  '{schema:"cyberhive.live.host_disk_guard.v1",status:$status,policy:"no writable mounts backed by non-removable physical disks",violations:$violations}' \
  >"$CYBERHIVE_EVIDENCE_DIR/host-disk-guard.json"

cat "$CYBERHIVE_EVIDENCE_DIR/host-disk-guard.json"
exit "$rc"
