#!/bin/sh
set -eu
. /etc/cyberhive/live/config.env
service_state() { value=$(systemctl is-active "$1" 2>/dev/null || true); [ -n "$value" ] || value=inactive; printf '%s' "$value"; }

lan_ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 != "tailscale0" {split($4,a,"/"); print a[1]; exit}' || true)
ts_ip=$(tailscale ip -4 2>/dev/null | head -n 1 || true)
ts_backend=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "unknown"' 2>/dev/null || printf '%s' unknown)
auth_mode=$(cat "$CYBERHIVE_STATE_DIR/ssh-mode" 2>/dev/null || printf '%s' unknown)
ssh_bootstrap=$(cat "$CYBERHIVE_STATE_DIR/ssh-bootstrap-status" 2>/dev/null || printf '%s' unknown)
session_id=$(cat "$CYBERHIVE_STATE_DIR/session-id" 2>/dev/null || printf '%s' unknown)
fingerprint=$(cat "$CYBERHIVE_STATE_DIR/ssh-host-fingerprint" 2>/dev/null || printf '%s' unknown)
role=$(cat "$CYBERHIVE_CONTROL_DIR/role" 2>/dev/null || printf '%s' "$CYBERHIVE_DEFAULT_ROLE")
guard=$(jq -r '.status // "pending"' "$CYBERHIVE_EVIDENCE_DIR/host-disk-guard.json" 2>/dev/null || printf '%s' pending)
management_firewall='fail'
if [ "$(id -u)" -eq 0 ]; then
  if /usr/local/bin/cyberhive-management-firewall-attest >/dev/null 2>&1; then management_firewall='pass'; fi
else
  if sudo -n /usr/local/bin/cyberhive-management-firewall-attest >/dev/null 2>&1; then management_firewall='pass'; fi
fi
persist_state=$(cat "$CYBERHIVE_STATE_DIR/persistence-state" 2>/dev/null || printf '%s' unknown)
root_source=$(findmnt -nr -o SOURCE / 2>/dev/null || printf '%s' unknown)
root_fstype=$(findmnt -nr -o FSTYPE / 2>/dev/null || printf '%s' unknown)

onboarding_service=$(service_state cyberhive-onboarding-init)
ssh_service=$(service_state ssh)
web_service=$(service_state cyberhive-web)
mdns_service=$(service_state avahi-daemon)
tailscale_service=$(service_state tailscaled)

observations=$(jq -n   --arg onboarding_service "$onboarding_service"   --arg ssh_service "$ssh_service"   --arg web_service "$web_service"   --arg mdns_service "$mdns_service"   --arg host_disk_guard "$guard"   --arg management_firewall "$management_firewall"   --arg persistence "$CYBERHIVE_PERSISTENCE_DEFAULT"   --arg persistence_state "$persist_state"   --arg lan_ip "$lan_ip"   --arg tailscale_service "$tailscale_service"   --arg tailscale_backend "$ts_backend"   --arg tailscale_ip "$ts_ip"   '{onboarding_service:$onboarding_service,ssh_service:$ssh_service,web_service:$web_service,mdns_service:$mdns_service,host_disk_guard:$host_disk_guard,management_firewall:$management_firewall,persistence:$persistence,persistence_state:$persistence_state,lan_ip:$lan_ip,tailscale_service:$tailscale_service,tailscale_backend:$tailscale_backend,tailscale_ip:$tailscale_ip}')

health=$(printf '%s\n' "$observations" | /usr/local/bin/cyberhive-health-classify)
local_safe=$(printf '%s\n' "$health" | jq -r '.local_safe')
status='degraded'
[ "$local_safe" = pass ] && status='ok'

web_url='pending'
[ -n "$ts_ip" ] && web_url="http://$ts_ip"

jq -n   --arg status "$status" --arg version "$CYBERHIVE_LIVE_VERSION" --arg hostname "$(hostname)"   --arg ipv4 "$lan_ip" --arg session_id "$session_id" --arg role "$role"   --arg onboarding_service "$onboarding_service" --arg ssh_service "$ssh_service"   --arg ssh_auth_mode "$auth_mode" --arg ssh_bootstrap "$ssh_bootstrap" --arg ssh_host_fingerprint "$fingerprint"   --arg web_service "$web_service" --arg web_url "$web_url" --arg mdns_service "$mdns_service"   --arg tailscale_service "$tailscale_service" --arg tailscale_backend "$ts_backend" --arg tailscale_ip "$ts_ip"   --arg host_disk_guard "$guard" --arg management_firewall "$management_firewall" --arg root_source "$root_source" --arg root_fstype "$root_fstype"   --arg persistence "$CYBERHIVE_PERSISTENCE_DEFAULT" --arg persistence_state "$persist_state"   --arg devbridge "$CYBERHIVE_DEVBRIDGE_DEFAULT" --arg mcp "$CYBERHIVE_MCP_DEFAULT" --arg remote_help "$CYBERHIVE_REMOTE_HELP_DEFAULT"   --argjson health "$health"   '{schema:"cyberhive.live.health.v1",status:$status,health:$health,version:$version,hostname:$hostname,ipv4:$ipv4,session_id:$session_id,role:$role,onboarding:{service:$onboarding_service},ssh:{service:$ssh_service,auth_mode:$ssh_auth_mode,bootstrap:$ssh_bootstrap,host_fingerprint:$ssh_host_fingerprint},web:{service:$web_service,url:$web_url},mdns:{service:$mdns_service},tailscale:{service:$tailscale_service,backend:$tailscale_backend,ip:$tailscale_ip},host_disk_guard:$host_disk_guard,management_firewall:$management_firewall,root:{source:$root_source,fstype:$root_fstype,persistence:$persistence},persistence_state:$persistence_state,devbridge:$devbridge,mcp:$mcp,remote_help:$remote_help}'
