#!/usr/bin/python3
from __future__ import annotations

import json
import shlex
import subprocess
import sys
from dataclasses import dataclass
from typing import Iterable


SCHEMA = "cyberhive.management.firewall.attestation.v1"


@dataclass(frozen=True)
class Rule:
    negated_input: str | None
    source: str | None
    protocol: str | None
    dport: str | None
    target: str | None
    extras: tuple[str, ...] = ()


EXPECTED_V4 = (
    Rule("tailscale0", "169.254.0.0/16", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "192.168.0.0/16", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "172.16.0.0/12", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "10.0.0.0/8", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "127.0.0.0/8", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", None, "tcp", "80", "DROP"),
    Rule("tailscale0", None, "tcp", "22", "DROP"),
)

EXPECTED_V6 = (
    Rule("tailscale0", "fe80::/10", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "fc00::/7", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", "::1/128", "tcp", "80", "ACCEPT"),
    Rule("tailscale0", None, "tcp", "80", "DROP"),
    Rule("tailscale0", None, "tcp", "22", "DROP"),
)


def _normalize_source(source: str | None) -> str | None:
    if source in {None, "0.0.0.0/0", "::/0"}:
        return None
    return source


def parse_input_rule(line: str) -> Rule | None:
    try:
        tokens = shlex.split(line)
    except ValueError:
        return None

    if len(tokens) < 3 or tokens[:2] != ["-A", "INPUT"]:
        return None

    negated_input: str | None = None
    source: str | None = None
    protocol: str | None = None
    dport: str | None = None
    target: str | None = None
    extras: list[str] = []
    index = 2

    while index < len(tokens):
        token = tokens[index]

        if token == "!" and index + 2 < len(tokens) and tokens[index + 1] == "-i":
            negated_input = tokens[index + 2]
            index += 3
            continue

        if token == "-i" and index + 1 < len(tokens):
            extras.extend([token, tokens[index + 1]])
            index += 2
            continue

        if token == "-s" and index + 1 < len(tokens):
            source = tokens[index + 1]
            index += 2
            continue

        if token == "-p" and index + 1 < len(tokens):
            protocol = tokens[index + 1]
            index += 2
            continue

        if token == "-m" and index + 1 < len(tokens):
            module = tokens[index + 1]
            if module != "tcp":
                extras.extend([token, module])
            index += 2
            continue

        if token == "--dport" and index + 1 < len(tokens):
            dport = tokens[index + 1]
            index += 2
            continue

        if token == "-j" and index + 1 < len(tokens):
            target = tokens[index + 1]
            index += 2
            continue

        extras.append(token)
        index += 1

    return Rule(
        negated_input=negated_input,
        source=_normalize_source(source),
        protocol=protocol,
        dport=dport,
        target=target,
        extras=tuple(extras),
    )


def _input_rules(lines: Iterable[str]) -> list[Rule | None]:
    result: list[Rule | None] = []
    for raw in lines:
        line = raw.strip()
        if not line.startswith("-A INPUT"):
            continue
        result.append(parse_input_rule(line))
    return result


def _prefix_matches(lines: Iterable[str], expected: tuple[Rule, ...]) -> bool:
    actual = _input_rules(lines)
    if len(actual) < len(expected):
        return False
    return tuple(actual[: len(expected)]) == expected


def attest_rule_lines(v4_lines: Iterable[str], v6_lines: Iterable[str]) -> dict[str, object]:
    ipv4 = "pass" if _prefix_matches(v4_lines, EXPECTED_V4) else "fail"
    ipv6 = "pass" if _prefix_matches(v6_lines, EXPECTED_V6) else "fail"

    reasons: list[str] = []
    if ipv4 != "pass":
        reasons.append("ipv4-prefix-mismatch")
    if ipv6 != "pass":
        reasons.append("ipv6-prefix-mismatch")

    return {
        "schema": SCHEMA,
        "status": "pass" if not reasons else "fail",
        "ipv4": ipv4,
        "ipv6": ipv6,
        "reasons": reasons,
    }


def _read_rules(binary: str) -> tuple[list[str] | None, str | None]:
    try:
        proc = subprocess.run(
            [binary, "-w", "2", "-S", "INPUT"],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None, f"{binary}-unavailable"

    if proc.returncode != 0:
        return None, f"{binary}-query-failed"

    return proc.stdout.splitlines(), None


def main() -> int:
    if len(sys.argv) != 1:
        print("cyberhive-management-firewall-attest: arguments are not accepted", file=sys.stderr)
        return 64

    v4, v4_error = _read_rules("iptables")
    v6, v6_error = _read_rules("ip6tables")

    if v4_error or v6_error:
        reasons = [reason for reason in (v4_error, v6_error) if reason]
        result = {
            "schema": SCHEMA,
            "status": "fail",
            "ipv4": "unknown" if v4_error else "pass",
            "ipv6": "unknown" if v6_error else "pass",
            "reasons": reasons,
        }
        json.dump(result, sys.stdout, sort_keys=True, separators=(",", ":"))
        sys.stdout.write("\n")
        return 2

    result = attest_rule_lines(v4 or [], v6 or [])
    json.dump(result, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0 if result["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
