#!/bin/sh
set -eu

. /etc/cyberhive/live/config.env
umask 077

mkdir -p "$CYBERHIVE_EVIDENCE_DIR" "$CYBERHIVE_CACHE_DIR" "$CYBERHIVE_STATE_DIR" "$CYBERHIVE_CONTROL_DIR" "$CYBERHIVE_PRIVATE_DIR" /run/cyberhive/config-media

if ! id cyberhive >/dev/null 2>&1; then
  echo 'cyberhive-onboarding-init: live user cyberhive does not exist' >&2
  exit 2
fi
if ! id "$CYBERHIVE_WEB_USER" >/dev/null 2>&1; then
  echo 'cyberhive-onboarding-init: web service user does not exist' >&2
  exit 2
fi
if ! getent group "$CYBERHIVE_CONTROL_GROUP" >/dev/null 2>&1; then
  echo 'cyberhive-onboarding-init: control group does not exist' >&2
  exit 2
fi

for path in "$CYBERHIVE_EVIDENCE_DIR" "$CYBERHIVE_CACHE_DIR" "$CYBERHIVE_STATE_DIR" "$CYBERHIVE_CONTROL_DIR"; do
  chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$path"
  chmod 2770 "$path"
done
chown root:cyberhive "$CYBERHIVE_PRIVATE_DIR"
chmod 0750 "$CYBERHIVE_PRIVATE_DIR"
usermod -a -G "$CYBERHIVE_CONTROL_GROUP" cyberhive >/dev/null 2>&1 || true

random_password=$(python3 -c 'import secrets; a="ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"; print("".join(secrets.choice(a) for _ in range(8)))')
pairing_code=$(python3 -c 'import secrets; print(f"{secrets.randbelow(1000000):06d}")')
session_id=$(python3 -c 'import secrets; print(secrets.token_hex(8))')

printf '%s\n' "$pairing_code" >"$CYBERHIVE_CONTROL_DIR/pairing-code"
printf '%s\n' "$session_id" >"$CYBERHIVE_STATE_DIR/session-id"
chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$CYBERHIVE_CONTROL_DIR/pairing-code" "$CYBERHIVE_STATE_DIR/session-id"
chmod 0640 "$CYBERHIVE_CONTROL_DIR/pairing-code" "$CYBERHIVE_STATE_DIR/session-id"

valid_authorized_keys() {
  file=$1
  [ -s "$file" ] || return 1
  bytes=$(wc -c <"$file" | tr -d ' ')
  [ "$bytes" -le 65536 ] || return 1
  awk '
    BEGIN { good=0; bad=0 }
    /^[[:space:]]*($|#)/ { next }
    $1 ~ /^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/ { good++; next }
    { bad++ }
    END { exit !(good > 0 && bad == 0) }
  ' "$file"
}

persist_state='absent'
persist_keys=''
persist_host_dir=''
if mountpoint -q "$CYBERHIVE_PERSIST_ROOT"; then
  persist_state='mounted'
  persist_keys="$CYBERHIVE_PERSIST_ROOT/state/ssh/authorized_keys"
  persist_host_dir="$CYBERHIVE_PERSIST_ROOT/state/ssh/host_keys"
fi

config_state='absent'
config_mount='/run/cyberhive/config-media'
cfg_dev=$(blkid -L "$CYBERHIVE_CONFIG_LABEL" 2>/dev/null || true)
if [ -n "$cfg_dev" ]; then
  mounted_at=$(findmnt -nr -S "$cfg_dev" -o TARGET 2>/dev/null | head -n 1 || true)
  if [ -n "$mounted_at" ]; then
    mount_opts=$(findmnt -nr -S "$cfg_dev" -o OPTIONS 2>/dev/null | head -n 1 || true)
    case ",$mount_opts," in
      *,ro,*) config_mount=$mounted_at; config_state='mounted-read-only' ;;
      *) config_state='rejected-existing-writable-mount' ;;
    esac
  elif mount -o ro,nodev,nosuid,noexec "$cfg_dev" "$config_mount"; then
    config_state='mounted-read-only'
  else
    config_state='mount-failed'
  fi
fi

key_source=''
auth_mode='ephemeral-password'
if [ -n "$persist_keys" ] && valid_authorized_keys "$persist_keys"; then
  key_source="$persist_keys"
  auth_mode='key-persistent'
elif [ "$config_state" = 'mounted-read-only' ] && valid_authorized_keys "$config_mount/authorized_keys"; then
  key_source="$config_mount/authorized_keys"
  auth_mode='key-config'
fi

mkdir -p /etc/ssh/sshd_config.d
if [ -n "$key_source" ]; then
  install -d -m 0700 -o cyberhive -g cyberhive /home/cyberhive/.ssh
  install -m 0600 -o cyberhive -g cyberhive "$key_source" /home/cyberhive/.ssh/authorized_keys
  passwd -l cyberhive >/dev/null 2>&1 || true
  cat >/etc/ssh/sshd_config.d/01-cyberhive-runtime.conf <<'EOSSH'
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
EOSSH
  rm -f "$CYBERHIVE_PRIVATE_DIR/ssh-password"
else
  printf 'cyberhive:%s\n' "$random_password" | chpasswd
  printf '%s\n' "$random_password" >"$CYBERHIVE_PRIVATE_DIR/ssh-password"
  chown root:cyberhive "$CYBERHIVE_PRIVATE_DIR/ssh-password"
  chmod 0640 "$CYBERHIVE_PRIVATE_DIR/ssh-password"
  cat >/etc/ssh/sshd_config.d/01-cyberhive-runtime.conf <<'EOSSH'
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods any
EOSSH
fi

printf '%s\n' "$auth_mode" >"$CYBERHIVE_STATE_DIR/ssh-mode"
printf '%s\n' "$config_state" >"$CYBERHIVE_STATE_DIR/config-media-state"
printf '%s\n' "$persist_state" >"$CYBERHIVE_STATE_DIR/persistence-state"
chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$CYBERHIVE_STATE_DIR/ssh-mode" "$CYBERHIVE_STATE_DIR/config-media-state" "$CYBERHIVE_STATE_DIR/persistence-state"
chmod 0640 "$CYBERHIVE_STATE_DIR/ssh-mode" "$CYBERHIVE_STATE_DIR/config-media-state" "$CYBERHIVE_STATE_DIR/persistence-state"

install -d -m 0755 -o root -g root /run/sshd

# Restore stable host identity from USB state before generating any missing key.
if [ -n "$persist_host_dir" ] && [ -d "$persist_host_dir" ]; then
  for key in "$persist_host_dir"/ssh_host_*; do
    [ -f "$key" ] || continue
    base=$(basename "$key")
    case "$base" in
      *.pub) install -m 0644 -o root -g root "$key" "/etc/ssh/$base" ;;
      *) install -m 0600 -o root -g root "$key" "/etc/ssh/$base" ;;
    esac
  done
fi
ssh-keygen -A >/dev/null

# Persist the generated/restored host identity only on the removable CyberHIVE STATE partition.
if [ -n "$persist_host_dir" ] && mountpoint -q "$CYBERHIVE_PERSIST_ROOT"; then
  install -d -m 0700 -o root -g root "$persist_host_dir"
  for key in /etc/ssh/ssh_host_*; do
    [ -f "$key" ] || continue
    base=$(basename "$key")
    case "$base" in
      *.pub) install -m 0644 -o root -g root "$key" "$persist_host_dir/$base" ;;
      *) install -m 0600 -o root -g root "$key" "$persist_host_dir/$base" ;;
    esac
  done
  sync
fi

host_fingerprint=$(ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256 2>/dev/null | awk '{print $2}' || true)
printf '%s\n' "$host_fingerprint" >"$CYBERHIVE_STATE_DIR/ssh-host-fingerprint"
chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$CYBERHIVE_STATE_DIR/ssh-host-fingerprint"
chmod 0640 "$CYBERHIVE_STATE_DIR/ssh-host-fingerprint"

ssh_bootstrap_status='ready'
if ! /usr/sbin/sshd -t; then ssh_bootstrap_status='config-invalid'; fi
printf '%s\n' "$ssh_bootstrap_status" >"$CYBERHIVE_STATE_DIR/ssh-bootstrap-status"
chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$CYBERHIVE_STATE_DIR/ssh-bootstrap-status"
chmod 0640 "$CYBERHIVE_STATE_DIR/ssh-bootstrap-status"

jq -n \
  --arg session_id "$session_id" \
  --arg ssh_auth_mode "$auth_mode" \
  --arg config_media "$config_state" \
  --arg persistence "$persist_state" \
  --arg ssh_host_fingerprint "$host_fingerprint" \
  --arg ssh_bootstrap_status "$ssh_bootstrap_status" \
  '{schema:"cyberhive.live.onboarding.v2",session_id:$session_id,ssh_auth_mode:$ssh_auth_mode,config_media:$config_media,persistence:$persistence,ssh_host_fingerprint:$ssh_host_fingerprint,ssh_bootstrap_status:$ssh_bootstrap_status}' \
  >"$CYBERHIVE_EVIDENCE_DIR/onboarding.json"
chown cyberhive:"$CYBERHIVE_CONTROL_GROUP" "$CYBERHIVE_EVIDENCE_DIR/onboarding.json"
chmod 0640 "$CYBERHIVE_EVIDENCE_DIR/onboarding.json"

if [ "$ssh_bootstrap_status" != 'ready' ]; then
  echo 'cyberhive-onboarding-init: sshd configuration validation failed' >&2
  exit 3
fi
