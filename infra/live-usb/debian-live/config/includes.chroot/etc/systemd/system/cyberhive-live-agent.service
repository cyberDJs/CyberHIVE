[Unit]
Description=CyberHIVE Live Appliance health surface
Documentation=file:/usr/local/bin/cyberhive-live-health
After=network-online.target cyberhive-onboarding-init.service cyberhive-host-disk-guard.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cyberhive-live-health
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
