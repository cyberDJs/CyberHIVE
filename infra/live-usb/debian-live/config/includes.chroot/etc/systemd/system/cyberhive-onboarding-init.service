[Unit]
Description=CyberHIVE per-boot local onboarding bootstrap
Requires=cyberhive-persist-init.service
After=local-fs.target live-config.service cyberhive-persist-init.service
Before=ssh.service cyberhive-web.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cyberhive-onboarding-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
