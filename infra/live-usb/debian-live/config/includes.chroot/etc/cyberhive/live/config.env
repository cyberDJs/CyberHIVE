# CyberHIVE Live Appliance v0.3 runtime defaults.
# No passwords, auth tokens or private keys are allowed here.

CYBERHIVE_LIVE_VERSION="0.3.0-dev"
CYBERHIVE_DEFAULT_ROLE="role-selector"
CYBERHIVE_DEVBRIDGE_DEFAULT="disabled"
CYBERHIVE_MCP_DEFAULT="disabled"
CYBERHIVE_REMOTE_HELP_DEFAULT="disabled"
CYBERHIVE_HOST_DISK_WRITE_DEFAULT="disabled"
CYBERHIVE_PERSISTENCE_DEFAULT="usb-state"
CYBERHIVE_CONFIG_LABEL="CYBERHIVE_CFG"
CYBERHIVE_EFI_LABEL="CYBER_EFI"
CYBERHIVE_SLOT_A_LABEL="CYBERHIVE_A"
CYBERHIVE_SLOT_B_LABEL="CYBERHIVE_B"
CYBERHIVE_STATE_LABEL="CYBERHIVE_STATE"
CYBERHIVE_PERSIST_ROOT="/var/lib/cyberhive-persist"
CYBERHIVE_TAILSCALE_HOSTNAME="cyberhive-dev-01"
CYBERHIVE_OTA_CHANNEL="dev"
CYBERHIVE_OTA_CHANNEL_URL="https://raw.githubusercontent.com/cyberDJs/CyberHIVE/cyberhive-dev-channel/channel.json"
CYBERHIVE_WEB_PORT="80"
CYBERHIVE_WEB_USER="cyberhive-web"
CYBERHIVE_CONTROL_GROUP="cyberhive-control"
CYBERHIVE_EVIDENCE_DIR="/run/cyberhive/evidence"
CYBERHIVE_CACHE_DIR="/run/cyberhive/cache"
CYBERHIVE_STATE_DIR="/run/cyberhive/state"
CYBERHIVE_CONTROL_DIR="/run/cyberhive/control"
CYBERHIVE_PRIVATE_DIR="/run/cyberhive/private"
CYBERHIVE_BRAND_THEME="cyberdjs-cyberhive-v0.3"
