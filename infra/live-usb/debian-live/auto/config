#!/bin/sh
set -eu

# CyberHIVE Live USB build configuration skeleton.
# This file is intentionally conservative: it defines the expected live-build
# shape without claiming that an ISO has been built or boot-tested yet.

lb config \
  --distribution bookworm \
  --archive-areas "main contrib non-free-firmware" \
  --binary-images iso-hybrid \
  --bootappend-live "boot=live components quiet splash username=cyberhive hostname=cyberhive-live" \
  --debian-installer false \
  --memtest none
