{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberhive.local/schemas/secure-node-gateway-receipt.schema.json",
  "title": "CyberHIVE Secure Node Gateway Receipt",
  "type": "object",
  "required": ["id", "status", "envelope_id", "node_id", "session_id", "purpose", "direction", "reason", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^gw_[a-f0-9]{20}$"},
    "status": {"type": "string", "enum": ["accepted", "denied", "dispatched", "recorded", "error"]},
    "envelope_id": {"type": "string"},
    "node_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "purpose": {"type": "string", "enum": ["heartbeat", "action", "action_result", "ack", "error"]},
    "direction": {"type": "string", "enum": ["node_to_controller", "controller_to_node"]},
    "reason": {"type": "string"},
    "verification": {"type": ["object", "null"]},
    "result": {},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
