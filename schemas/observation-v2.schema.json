{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberhive.local/schemas/observation-v2.schema.json",
  "title": "CyberHIVE Observation v2",
  "type": "object",
  "required": ["id", "source", "name", "kind", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^obs_[A-Za-z0-9_-]+$"},
    "source": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "string", "boolean", "null"]},
    "kind": {"type": "string", "enum": ["metric", "event", "state", "log", "trace"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "resource_id": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "severity": {"type": "string", "enum": ["debug", "info", "warning", "error", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "dimensions": {"type": "object", "additionalProperties": {"type": "string"}},
    "payload": {"type": "object"},
    "ttl_seconds": {"type": ["integer", "null"], "minimum": 0}
  }
}
